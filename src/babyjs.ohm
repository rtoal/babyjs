BabyJS {
  Program     = Statement*

  Statement   = PrintStmt
              | LetStmt
              | AssignStmt
              | IfStmt
              | WhileStmt
              | FunDecl

  PrintStmt   = print "(" Exp ")"
  LetStmt     = let id "=" Exp
  AssignStmt  = Primary_id "=" Exp
  IfStmt      = if Exp Block else Block   --else
              | if Exp Block              --noelse
  WhileStmt   = while Exp Block
  FunDecl     = function id "(" Params ")" "=" Exp

  Block       = "{" Statement* "}"

  Params      = ListOf<Binding, ",">
  Binding     = id ":" Type

  Type        = number | boolean

  Exp         = Condition relop Condition  -- binary
              | Condition

  Condition   = Condition addop Term       -- binary
              | Term

  Term        = Term mulop Factor          -- binary
              | Factor

  Factor      = Primary "**" Factor        -- exponentiation
              | "-" Primary                -- negation
              | Primary

  Primary     = num
              | false
              | true
              | id "(" Args ")"            -- call
              | id                         -- id
              | "(" Exp ")"                -- parens

  Args        = ListOf<Exp, ",">
  relop       = "<=" | ">=" | "<" | ">" | "==" | "!="
  addop       = "+" | "-"
  mulop       = "*" | "/" | "%"

  num         = digit+

  let         = "let" ~alnum
  print       = "print" ~alnum
  if          = "if" ~alnum
  else        = "else" ~alnum
  while       = "while" ~alnum
  false       = "false" ~alnum
  true        = "true" ~alnum
  function    = "function" ~alnum
  number      = "number" ~alnum
  boolean     = "boolean" ~alnum
  keyword     = let | print | if | else | while | false | true
              | function | number | boolean

  id          = ~keyword letter alnum*

  space      += comment
  comment     = "//" (~"\n" any)*
}